# Telegram bot token (get one from @BotFather)
TG_BOT_TOKEN=

# Comma- or space-separated list of Telegram user IDs allowed to talk to this bot.
# Get your own ID by sending /start to @userinfobot.
# If left empty the bot will respond to ANYONE — strongly discouraged.
# In groups, every speaker the bot should respond to must be listed here.
ALLOWED_USER_IDS=

# Display names: how the persona should refer to each user_id.
# Format: id:name,id:name,... (e.g. 435477395:Li,91713083:Domi)
# Falls back to the TG profile first_name when an id isn't listed.
USER_NAMES=

# Model passed to `claude -p --model`. Leave blank to use Claude Code's default.
# Examples: claude-opus-4-7, claude-sonnet-4-6, opus, sonnet
CLAUDE_MODEL=

# How long (seconds) to wait for `claude -p` before killing it.
CLAUDE_TIMEOUT_SECONDS=120

# Path to the claude binary (override if it's not on PATH for the running user)
CLAUDE_BIN=claude
